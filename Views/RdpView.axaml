<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="clr-namespace:CxShell.ViewModels"
             x:Class="CxShell.Views.RdpView"
             x:DataType="vm:RdpViewModel"
             Focusable="True"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid>
        <Border x:Name="RdpViewport"
                Background="#111111"
                ClipToBounds="True"
                SizeChanged="OnViewportSizeChanged">
            <Image x:Name="FramebufferImage"
                   Source="{Binding Framebuffer}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Focusable="True"
                   PointerMoved="OnFramebufferPointerMoved"
                   PointerPressed="OnFramebufferPointerPressed"
                   PointerReleased="OnFramebufferPointerReleased"
                   PointerWheelChanged="OnFramebufferPointerWheelChanged"/>
        </Border>
    </Grid>
</UserControl>
