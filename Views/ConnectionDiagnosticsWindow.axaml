<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:antdicons="https://atomui.net/icons/antdesign"
        xmlns:vm="using:CxShell.ViewModels"
        x:Class="CxShell.Views.ConnectionDiagnosticsWindow"
        x:DataType="vm:ConnectionDiagnosticsViewModel"
        Title="{Binding TitleText}"
        Width="760"
        Height="500"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
            BorderBrush="{atom:SharedTokenResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{atom:SharedTokenResource ColorText}"/>
                    <TextBlock Text="{Binding TargetText}"
                               FontSize="11"
                               Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <atom:Button Grid.Column="1"
                             Width="28"
                             Height="28"
                             Padding="0"
                             ButtonType="Text"
                             Background="Transparent"
                             BorderThickness="0"
                             Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                             Click="OnCloseClick"
                             ToolTip.Tip="{Binding CloseText}"/>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.2*" ColumnSpacing="14">
                <Border Grid.Column="0"
                        Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding StepsText}"
                                   FontWeight="SemiBold"
                                   Foreground="{atom:SharedTokenResource ColorText}"/>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ConnectionDiagnosticStepViewModel">
                                    <StackPanel Spacing="3" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{atom:SharedTokenResource ColorText}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusDisplay}"
                                                       FontSize="11"
                                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{atom:SharedTokenResource ColorBgLayout}"
                        BorderBrush="{atom:SharedTokenResource ColorSplit}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding RunningText}"
                                       IsVisible="{Binding IsBusy}"
                                       Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                            <Border Background="{atom:SharedTokenResource ColorSuccessBg}"
                                    CornerRadius="4"
                                    Padding="10"
                                    IsVisible="{Binding AllPassed}">
                                <TextBlock Text="{Binding AllPassedText}"
                                           Foreground="{atom:SharedTokenResource ColorSuccess}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Spacing="6" IsVisible="{Binding HasIssue}">
                                <TextBlock Text="{Binding IssueLabelText}"
                                           Foreground="{atom:SharedTokenResource ColorWarning}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding IssueTitle}"
                                           Foreground="{atom:SharedTokenResource ColorText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding IssueDescription}"
                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="5" IsVisible="{Binding HasSuggestions}">
                                <TextBlock Text="{Binding SuggestionsText}"
                                           Foreground="{atom:SharedTokenResource ColorText}" 
                                           FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"
                                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <atom:Button Content="{Binding ExportText}"
                             ButtonType="Default"
                             IsEnabled="{Binding CanExport}"
                             Click="OnExportClick"/>
                <atom:Button Content="{Binding RerunText}"
                             ButtonType="Primary"
                             Command="{Binding RunCommand}"/>
                <atom:Button Content="{Binding CloseText}"
                             ButtonType="Default"
                             Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
