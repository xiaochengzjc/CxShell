<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.TrustedHostsPage"
             x:DataType="vm:ApplicationSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,2,12,8">
            <TextBlock Text="{Binding KnownHostsText}"
                       FontWeight="SemiBold"
                       Foreground="{atom:SharedTokenResource ColorText}"/>
            <TextBlock Text="{Binding SshSecurityText}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
            <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                    BorderBrush="{atom:SharedTokenResource ColorSplit}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8">
                <Grid>
                    <TextBlock Text="{Binding NoKnownHostsText}"
                               IsVisible="{Binding !HasKnownHosts}"
                               Margin="6,8"
                               Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                    <ItemsControl ItemsSource="{Binding KnownHosts}"
                                  IsVisible="{Binding HasKnownHosts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KnownSshHostKeyItemViewModel">
                                <Border BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                        BorderThickness="0,0,0,1"
                                        Padding="6,7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding EndpointText}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{atom:SharedTokenResource ColorText}"/>
                                                <TextBlock Text="{Binding KeyTypeText}"
                                                           FontSize="11"
                                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                                <TextBlock Text="{Binding LastSeenText}"
                                                           FontSize="11"
                                                           Foreground="{atom:SharedTokenResource ColorTextTertiary}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FingerprintText}"
                                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                        </StackPanel>
                                        <atom:Button Grid.Column="1"
                                                     Width="28"
                                                     Height="28"
                                                     Padding="0"
                                                     ButtonType="Text"
                                                     Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}"
                                                     Command="{Binding RemoveCommand}"
                                                     atom:ToolTip.Tip="{Binding RemoveText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
