<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CxShell.Controls"
             xmlns:services="using:CxShell.Services"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.VncWindow"
             x:DataType="vm:VncViewModel"
             Title="VNC - CxShell"
             Width="1024"
             Height="768"
             MinWidth="640"
             MinHeight="480"
             WindowStartupLocation="CenterOwner"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="0"
                Background="#111111"
                ClipToBounds="True">
            <controls:VncClientView x:Name="RemoteView"
                                    Connection="{Binding Connection}"
                                    DisplayMode="{Binding DisplayMode}"
                                    ScalePercent="{Binding ScalePercent}"
                                    IsKeyboardInputEnabled="{Binding EnableKeyboardInput}"
                                    IsMouseInputEnabled="{Binding EnableMouseInput}"
                                    CaptureShortcuts="{Binding CaptureShortcuts}"
                                    CursorMode="{Binding CursorMode}"
                                    ClipboardMode="{Binding ClipboardMode}"
                                    ResizeMode="{Binding ResizeMode}"
                                    Focusable="True"/>
        </Border>

        <Border Grid.Row="1"
                Padding="8,5"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <atom:TextBlock Text="{Binding StatusText}"/>
                <atom:TextBlock Opacity="0.7">
                    <atom:TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}x{1}">
                            <Binding Path="RemoteWidth"/>
                            <Binding Path="RemoteHeight"/>
                        </MultiBinding>
                    </atom:TextBlock.Text>
                </atom:TextBlock>
                <atom:Button Content="{Binding [UiText.259], Source={x:Static services:LocalizationService.Shared}}"
                             Padding="10,2"
                             Click="OnSendClipboardClick"/>
                <atom:Button Content="Ctrl+Alt+Del"
                             Padding="10,2"
                             IsEnabled="{Binding IsConnected}"
                             Command="{Binding SendCtrlAltDeleteCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</atom:Window>
