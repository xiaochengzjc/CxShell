<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CxShell.Controls"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.VncView"
             x:DataType="vm:VncViewModel"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid>
        <Border Background="#111111"
                ClipToBounds="True">
            <controls:VncClientView x:Name="RemoteView"
                                    Connection="{Binding Connection}"
                                    DisplayMode="{Binding DisplayMode}"
                                    ScalePercent="{Binding ScalePercent}"
                                    IsKeyboardInputEnabled="{Binding EnableKeyboardInput}"
                                    IsMouseInputEnabled="{Binding EnableMouseInput}"
                                    CaptureShortcuts="{Binding CaptureShortcuts}"
                                    CursorMode="{Binding CursorMode}"
                                    ClipboardMode="{Binding ClipboardMode}"
                                    ResizeMode="{Binding ResizeMode}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Focusable="True"/>
        </Border>
    </Grid>
</UserControl>
