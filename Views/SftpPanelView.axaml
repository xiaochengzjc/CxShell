<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             xmlns:models="using:CxShell.Models"
             x:Class="CxShell.Views.SftpPanelView"
             x:DataType="vm:SftpViewModel">

    <UserControl.Styles>
        <Style Selector="atom|DataGrid.sftp-file-grid atom|DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="atom|DataGrid.sftp-file-grid atom|DataGridColumnHeader /template/ Border#PART_ContentFrame">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style Selector="atom|DataGrid.sftp-file-grid atom|DataGridColumnHeader">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="atom|DataGrid.sftp-transfer-grid atom|DataGridCell">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="atom|DataGrid.sftp-transfer-grid atom|DataGridColumnHeader /template/ Border#PART_ContentFrame">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="atom|DataGrid.sftp-transfer-grid atom|DataGridColumnHeader">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Background="{atom:SharedTokenResource ColorBgLayout}">

        <Border Grid.Row="0"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                Padding="10,8,4,8">
            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="📁"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{atom:SharedTokenResource ColorText}"/>
                    <TextBlock Text="{Binding ProtocolLabel}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{atom:SharedTokenResource ColorText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostLabel}"
                               FontSize="11"
                               Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                               VerticalAlignment="Center"/>
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding IsConnected, Converter={x:Static vm:SftpStatusColorConverter.Instance}}"/>
                    <atom:Button Width="20"
                                 Height="20"
                                 Padding="0"
                                 Margin="0,0,-1,0"
                                 ButtonType="Text"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                 Command="{Binding $parent[UserControl].PanelCloseCommand, x:CompileBindings=False}"
                                 IsVisible="{Binding $parent[UserControl].IsPanelCloseButtonVisible, x:CompileBindings=False}"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                Padding="6,4"
                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                BorderThickness="0,0,0,1">
            <Grid>
                <atom:LineEdit
                               x:Name="RemotePathInput"
                               Text="{Binding PathInput, Mode=TwoWay}"
                               PlaceholderText="/home/user"
                               IsAllowClear="False"
                               IsEnabled="{Binding IsConnected}"
                               FontSize="12"
                               Height="32"
                               HorizontalAlignment="Stretch"
                               GotFocus="OnRemotePathInputGotFocus"
                               KeyDown="OnRemotePathInputKeyDown"/>
                <Popup x:Name="PathSuggestionPopup"
                       IsOpen="{Binding IsPathSuggestionOpen}"
                       PlacementTarget="{Binding ElementName=RemotePathInput}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                    <Border Width="{Binding Bounds.Width, ElementName=RemotePathInput}"
                            MaxHeight="220"
                            Background="{atom:SharedTokenResource ColorBgElevated}"
                            BorderBrush="{atom:SharedTokenResource ColorBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            BoxShadow="0 6 18 0 #26000000"
                            Padding="2">
                        <ListBox ItemsSource="{Binding PathSuggestions}"
                                 SelectedIndex="{Binding SelectedPathSuggestionIndex, Mode=TwoWay}"
                                 PointerReleased="OnPathSuggestionPointerReleased"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 MaxHeight="214">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:SftpPathSuggestionItem">
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="6"
                                          MinHeight="28"
                                          Margin="4,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CompletionPath}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{atom:SharedTokenResource ColorText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                Padding="6,4"
                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="2">
                <atom:Button Background="{atom:SharedTokenResource ColorFillTertiary}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding NavigateHomeCommand}"
                             CornerRadius="4">
                    <TextBlock Text="🏠"
                               FontSize="14"
                               Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                </atom:Button>
                <atom:Button Background="{atom:SharedTokenResource ColorFillTertiary}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding NavigateUpCommand}"
                             CornerRadius="4">
                    <TextBlock Text="↑"
                               FontSize="14"
                               Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                               FontWeight="Bold"/>
                </atom:Button>
                <atom:Button Background="{atom:SharedTokenResource ColorFillTertiary}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding RefreshCommand}"
                             CornerRadius="4">
                    <TextBlock Text="↻"
                               FontSize="14"
                               Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                               FontWeight="Bold"/>
                </atom:Button>
                <Border Width="1"
                        Background="{atom:SharedTokenResource ColorBorder}"
                        Margin="4,4"/>
                <atom:Button Background="{atom:SharedTokenResource ColorSuccessBg}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding UploadCommand}"
                             IsEnabled="{Binding IsConnected}"
                             CornerRadius="4">
                    <TextBlock Text="{Binding UploadText}"
                               FontSize="12"
                               Foreground="{atom:SharedTokenResource ColorSuccess}"
                               FontWeight="Bold"/>
                </atom:Button>
                <atom:Button Background="{atom:SharedTokenResource ColorInfoBg}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding DownloadCommand}"
                             IsEnabled="{Binding IsConnected}"
                             CornerRadius="4">
                    <TextBlock Text="{Binding DownloadText}"
                               FontSize="12"
                               Foreground="{atom:SharedTokenResource ColorInfo}"
                               FontWeight="Bold"/>
                </atom:Button>
                <atom:Button Background="{atom:SharedTokenResource ColorWarningBg}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding CreateDirectoryCommand}"
                             IsEnabled="{Binding IsConnected}"
                             CornerRadius="4">
                    <TextBlock Text="{Binding NewDirectoryText}"
                               FontSize="12"
                               Foreground="{atom:SharedTokenResource ColorWarning}"
                               FontWeight="Bold"/>
                </atom:Button>
                <atom:Button Background="{atom:SharedTokenResource ColorErrorBg}"
                             BorderThickness="0"
                             Padding="8,5"
                             Command="{Binding DeleteCommand}"
                             IsEnabled="{Binding HasSelectedFiles}"
                             CornerRadius="4">
                    <TextBlock Text="{Binding DeleteText}"
                               FontSize="12"
                               Foreground="{atom:SharedTokenResource ColorError}"
                               FontWeight="Bold"/>
                </atom:Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{atom:SharedTokenResource ColorErrorBg}"
                Padding="8,4"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{atom:SharedTokenResource ColorErrorText}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="4"
              RowDefinitions="Auto,*"
              Background="Transparent"
              DragDrop.AllowDrop="{Binding IsConnected}"
              DragDrop.DragOver="OnFileListDragOver"
              DragDrop.Drop="OnFileListDrop">
            <Border Grid.Row="0"
                    Background="{atom:SharedTokenResource ColorBgContainer}"
                    BorderBrush="{atom:SharedTokenResource ColorSplit}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4"
                    IsVisible="{Binding IsCreatingDirectory}">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="+"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                    <atom:TextBox Grid.Column="1"
                                  x:Name="NewDirInput"
                                  Text="{Binding NewDirectoryName, Mode=TwoWay}"
                                  FontSize="12"
                                  BorderThickness="0,0,0,1"
                                  Padding="2,2"
                                  VerticalAlignment="Center"
                                  KeyDown="OnNewDirInputKeyDown"
                                  LostFocus="OnNewDirInputLostFocus"/>
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Grid.RowSpan="2"
                        IsVisible="{Binding !IsConnected}">
                <TextBlock Text="📁"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Opacity="0.3"/>
                <TextBlock Text="{Binding ConnectHintText}"
                           FontSize="12"
                           Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <atom:Spin Grid.Row="1"
                       IsVisible="{Binding IsConnected}"
                       IsSpinning="{Binding IsLoading}"
                       IsTipVisible="{Binding IsLoading}"
                       Tip="{Binding LoadingText}"
                       SizeType="Middle"
                       IsMaskBackgroundEnabled="False"
                       IsMaskBlurEnabled="False"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch">
                <atom:DataGrid x:Name="FileGrid"
                               Classes="sftp-file-grid"
                               ItemsSource="{Binding Files}"
                               SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               SelectionMode="Extended"
                               SizeType="Small"
                               RowHeight="30"
                               GridLinesVisibility="All"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="True"
                               IsHideOnSinglePage="True"
                               HeadersVisibility="Column"
                               SelectionChanged="OnFileGridSelectionChanged"
                               PointerMoved="OnFileGridPointerMoved"
                               PointerReleased="OnFileGridPointerReleased"
                               KeyDown="OnFileGridKeyDown">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTemplateColumn Header="{Binding NameText}"
                                                     SortMemberPath="Name"
                                                     Width="1*"
                                                     MinWidth="100"
                                                     CanUserResize="True">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:SftpFileItem">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                   Margin="0,0,6,0"/>
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding !IsRenaming}"
                                                       Foreground="{Binding IsDirectory, Converter={x:Static vm:SftpDirColorConverter.Instance}}"/>
                                            <atom:TextBox Text="{Binding RenamingText, Mode=TwoWay}"
                                                          FontSize="12"
                                                          BorderThickness="0,0,0,1"
                                                          Padding="2,1"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding IsRenaming}"
                                                          Tag="{Binding}"
                                                          KeyDown="OnRenameInputKeyDown"
                                                          LostFocus="OnRenameInputLostFocus"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTextColumn Header="{Binding SizeText}"
                                                 Binding="{Binding SizeDisplay}"
                                                 SortMemberPath="Size"
                                                 Width="0.8*"
                                                 MinWidth="82"
                                                 CanUserResize="True"/>
                        <atom:DataGridTextColumn Header="{Binding ModifiedText}"
                                                 Binding="{Binding DateDisplay}"
                                                 SortMemberPath="LastModified"
                                                 Width="*"
                                                 MinWidth="118"
                                                 CanUserResize="True"/>
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </atom:Spin>
        </Grid>

        <Border Grid.Row="5"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="8"
                      MinHeight="34"
                      Margin="8,4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding TransferQueueTitleText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{atom:SharedTokenResource ColorText}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TransferSummaryText}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                               TextTrimming="CharacterEllipsis"/>
                    <atom:Button Grid.Column="2"
                                 Height="24"
                                 Padding="7,2"
                                 ButtonType="Text"
                                 IsEnabled="{Binding HasCompletedTransfers}"
                                 Command="{Binding ClearCompletedTransfersCommand}">
                        <TextBlock Text="{Binding ClearCompletedTransfersText}"
                                   FontSize="10"/>
                    </atom:Button>
                    <atom:Button Grid.Column="3"
                                 Height="24"
                                 Padding="7,2"
                                 ButtonType="Text"
                                 Command="{Binding ToggleTransferPanelCommand}">
                        <TextBlock Text="{Binding TransferPanelToggleText}"
                                   FontSize="10"/>
                    </atom:Button>
                </Grid>

                <atom:DataGrid x:Name="TransferGrid"
                               Grid.Row="1"
                               Classes="sftp-transfer-grid"
                               Height="176"
                               ItemsSource="{Binding TransferTasks}"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               SelectionMode="Single"
                               SizeType="Small"
                               RowHeight="32"
                               GridLinesVisibility="All"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="False"
                               RightFrozenColumnCount="2"
                               IsHideOnSinglePage="True"
                               HeadersVisibility="Column"
                               IsVisible="{Binding IsTransferPanelExpanded}">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="{Binding TransferTypeText}"
                                                 Binding="{Binding DirectionText}"
                                                 Width="64"
                                                 MinWidth="58"/>
                        <atom:DataGridTextColumn Header="{Binding TransferFileText}"
                                                 Binding="{Binding FileName}"
                                                 Width="140"
                                                 MinWidth="100"/>
                        <atom:DataGridTextColumn Header="{Binding SizeText}"
                                                 Binding="{Binding SizeText}"
                                                 Width="150"
                                                 MinWidth="120"/>
                        <atom:DataGridTemplateColumn Header="{Binding TransferProgressText}"
                                                     Width="180"
                                                     MinWidth="150">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vm:SftpTransferTaskItem">
                                    <Grid ColumnDefinitions="*,46"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <atom:ProgressBar Grid.Column="0"
                                                          Value="{Binding ProgressPercent}"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          IsProgressInfoVisible="False"
                                                          Height="6"
                                                          VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressText}"
                                                   FontSize="10"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTextColumn Header="{Binding TransferSpeedText}"
                                                 Binding="{Binding SpeedText}"
                                                 Width="90"
                                                 MinWidth="78"/>
                        <atom:DataGridTextColumn Header="{Binding TransferRemainingText}"
                                                 Binding="{Binding RemainingText}"
                                                 Width="88"
                                                 MinWidth="78"/>
                        <atom:DataGridTextColumn Header="{Binding TransferTargetText}"
                                                 Binding="{Binding TargetPath}"
                                                 Width="210"
                                                 MinWidth="140"/>
                        <atom:DataGridTemplateColumn Header="{Binding TransferStatusText}"
                                                     Width="80"
                                                     MinWidth="72">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vm:SftpTransferTaskItem">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ErrorMessage}"/>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTemplateColumn Header="{Binding TransferOperationText}"
                                                     Width="76"
                                                     MinWidth="70">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vm:SftpTransferTaskItem">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <atom:Button Height="23"
                                                     Padding="6,1"
                                                     ButtonType="Text"
                                                     IsVisible="{Binding CanCancel}"
                                                     Command="{Binding $parent[UserControl].DataContext.CancelTransferCommand, x:CompileBindings=False}"
                                                     CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.CancelTransferText, x:CompileBindings=False}"
                                                       FontSize="10"/>
                                        </atom:Button>
                                        <atom:Button Height="23"
                                                     Padding="6,1"
                                                     ButtonType="Text"
                                                     IsVisible="{Binding CanRetry}"
                                                     Command="{Binding $parent[UserControl].DataContext.RetryTransferCommand, x:CompileBindings=False}"
                                                     CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.RetryTransferText, x:CompileBindings=False}"
                                                       FontSize="10"/>
                                        </atom:Button>
                                        <atom:Button Height="23"
                                                     Padding="6,1"
                                                     ButtonType="Text"
                                                     IsVisible="{Binding CanRemove}"
                                                     Command="{Binding $parent[UserControl].DataContext.RemoveTransferCommand, x:CompileBindings=False}"
                                                     CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.RemoveTransferText, x:CompileBindings=False}"
                                                       FontSize="10"/>
                                        </atom:Button>
                                    </StackPanel>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
