<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.UpdatePage"
             x:DataType="vm:SettingsCenterViewModel">
    <StackPanel Spacing="18" Margin="0,2,12,8">
        <Border Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorSplit}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="18">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding UpdateCurrentVersionText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{atom:SharedTokenResource ColorText}"/>
                <TextBlock Text="{Binding UpdateDescriptionText}"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                <atom:Button Content="{Binding CheckForUpdatesText}"
                             Icon="{antdicons:AntDesignIconProvider Kind=CloudSyncOutlined}"
                             Command="{Binding CheckForUpdatesCommand}"
                             HorizontalAlignment="Left"
                             ButtonType="Primary"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
